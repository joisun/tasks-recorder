{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "paths": {
      "@/*": ["./ui/react/*"]
    }
  },
  "include": [
    "ui/react/**/*.ts",
    "ui/react/**/*.tsx",
    "vitest.config.ts"
  ]
}
