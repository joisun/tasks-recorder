{
  "name": "tasks-recorder",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "bin": {
    "tasks-recorder": "server/cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node ui/build.mjs",
    "check": "node scripts/check-syntax.mjs",
    "taskd": "node server/control.mjs",
    "taskd:run": "node server/taskd.mjs",
    "test": "node --test test/*.test.mjs",
    "build:adapters": "node scripts/build-adapters.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@svar-ui/react-gantt": "2.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "description": "Local task control plane and real-time dashboard for coding agents",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joisun/tasks-recorder.git"
  },
  "homepage": "https://github.com/joisun/tasks-recorder#readme",
  "bugs": {
    "url": "https://github.com/joisun/tasks-recorder/issues"
  }
}
