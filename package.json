{
  "name": "tasks-recorder",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "bin": {
    "tasks-recorder": "server/cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-server-vendor.mjs && node ui/build.mjs",
    "dev:ui": "node ui/dev-server.mjs",
    "dev:ui:react": "node ui/dev-server.mjs --entry=react",
    "check": "node scripts/check-syntax.mjs && npm run check:types",
    "check:types": "tsc --noEmit",
    "taskd": "node server/control.mjs",
    "taskd:run": "node server/taskd.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ui": "vitest run",
    "build:adapters": "node scripts/build-adapters.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@svar-ui/react-gantt": "2.7.1",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "description": "Local task control plane and real-time dashboard for coding agents",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joisun/tasks-recorder.git"
  },
  "homepage": "https://github.com/joisun/tasks-recorder#readme",
  "bugs": {
    "url": "https://github.com/joisun/tasks-recorder/issues"
  }
}
