{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-task-sync.mjs\"",
            "timeout": 2,
            "statusMessage": "Syncing task context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/task-heartbeat.mjs\"",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/stop-task-check.mjs\"",
            "timeout": 5,
            "statusMessage": "Synchronizing task status"
          }
        ]
      }
    ]
  }
}
